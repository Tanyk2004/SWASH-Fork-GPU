    end type state_slot
!
    type(state_slot), dimension(max_slots), save, target :: slots
!
contains
!
    subroutine state_save ( islot )
       implicit none
       integer, intent(in) :: islot
       type(state_slot), pointer :: sl
       !
       sl => slots(islot)
       sl%used   = .true.
       sl%timco  = timco
       sl%dt     = dt
       sl%cflmax = cflmax
       sl%it     = it
       sl%istep  = istep
       sl%chtime = chtime
       !
       if ( allocated(brks) ) then
          if ( allocated(sl%brks) ) deallocate(sl%brks)
          allocate(sl%brks(lbound(brks,1):ubound(brks,1)))
          sl%brks = brks
       endif
       if ( allocated(ibb) ) then
          if ( allocated(sl%ibb) ) deallocate(sl%ibb)
          allocate(sl%ibb(lbound(ibb,1):ubound(ibb,1)))
          sl%ibb = ibb
       endif
       if ( allocated(ibl) ) then
          if ( allocated(sl%ibl) ) deallocate(sl%ibl)
          allocate(sl%ibl(lbound(ibl,1):ubound(ibl,1)))
          sl%ibl = ibl
       endif
       if ( allocated(ibr) ) then
          if ( allocated(sl%ibr) ) deallocate(sl%ibr)
          allocate(sl%ibr(lbound(ibr,1):ubound(ibr,1)))
          sl%ibr = ibr
       endif
       if ( allocated(ibt) ) then
          if ( allocated(sl%ibt) ) deallocate(sl%ibt)
          allocate(sl%ibt(lbound(ibt,1):ubound(ibt,1)))
          sl%ibt = ibt
       endif
       if ( allocated(lfbs) ) then
          if ( allocated(sl%lfbs) ) deallocate(sl%lfbs)
          allocate(sl%lfbs(lbound(lfbs,1):ubound(lfbs,1)))
          sl%lfbs = lfbs
       endif
       if ( allocated(mcell) ) then
          if ( allocated(sl%mcell) ) deallocate(sl%mcell)
          allocate(sl%mcell(lbound(mcell,1):ubound(mcell,1)))
          sl%mcell = mcell
       endif
       if ( allocated(mlev) ) then
          if ( allocated(sl%mlev) ) deallocate(sl%mlev)
          allocate(sl%mlev(lbound(mlev,1):ubound(mlev,1)))
          sl%mlev = mlev
       endif
       if ( allocated(presp) ) then
          if ( allocated(sl%presp) ) deallocate(sl%presp)
          allocate(sl%presp(lbound(presp,1):ubound(presp,1)))
          sl%presp = presp
       endif
       if ( allocated(presu) ) then
          if ( allocated(sl%presu) ) deallocate(sl%presu)
          allocate(sl%presu(lbound(presu,1):ubound(presu,1)))
          sl%presu = presu
       endif
       if ( allocated(presv) ) then
          if ( allocated(sl%presv) ) deallocate(sl%presv)
          allocate(sl%presv(lbound(presv,1):ubound(presv,1)))
          sl%presv = presv
       endif
       if ( allocated(uwetp) ) then
          if ( allocated(sl%uwetp) ) deallocate(sl%uwetp)
          allocate(sl%uwetp(lbound(uwetp,1):ubound(uwetp,1)))
          sl%uwetp = uwetp
       endif
       if ( allocated(vwetp) ) then
          if ( allocated(sl%vwetp) ) deallocate(sl%vwetp)
          allocate(sl%vwetp(lbound(vwetp,1):ubound(vwetp,1)))
          sl%vwetp = vwetp
       endif
       if ( allocated(wets) ) then
          if ( allocated(sl%wets) ) deallocate(sl%wets)
          allocate(sl%wets(lbound(wets,1):ubound(wets,1)))
          sl%wets = wets
       endif
       if ( allocated(wetu) ) then
          if ( allocated(sl%wetu) ) deallocate(sl%wetu)
          allocate(sl%wetu(lbound(wetu,1):ubound(wetu,1)))
          sl%wetu = wetu
       endif
       if ( allocated(wetv) ) then
          if ( allocated(sl%wetv) ) deallocate(sl%wetv)
          allocate(sl%wetv(lbound(wetv,1):ubound(wetv,1)))
          sl%wetv = wetv
       endif
       if ( allocated(ishif) ) then
          if ( allocated(sl%ishif) ) deallocate(sl%ishif)
          allocate(sl%ishif(lbound(ishif,1):ubound(ishif,1)))
          sl%ishif = ishif
       endif
       if ( allocated(a) ) then
          if ( allocated(sl%a) ) deallocate(sl%a)
          allocate(sl%a(lbound(a,1):ubound(a,1)))
          sl%a = a
       endif
       if ( allocated(advec) ) then
          if ( allocated(sl%advec) ) deallocate(sl%advec)
          allocate(sl%advec(lbound(advec,1):ubound(advec,1)))
          sl%advec = advec
       endif
       if ( allocated(advecx) ) then
          if ( allocated(sl%advecx) ) deallocate(sl%advecx)
          allocate(sl%advecx(lbound(advecx,1):ubound(advecx,1)))
          sl%advecx = advecx
       endif
       if ( allocated(advecy) ) then
          if ( allocated(sl%advecy) ) deallocate(sl%advecy)
          allocate(sl%advecy(lbound(advecy,1):ubound(advecy,1)))
          sl%advecy = advecy
       endif
       if ( allocated(amat) ) then
          if ( allocated(sl%amat) ) deallocate(sl%amat)
          allocate(sl%amat(lbound(amat,1):ubound(amat,1),lbound(amat,2):ubound(amat,2)))
          sl%amat = amat
       endif
       if ( allocated(amatc) ) then
          if ( allocated(sl%amatc) ) deallocate(sl%amatc)
          allocate(sl%amatc(lbound(amatc,1):ubound(amatc,1),lbound(amatc,2):ubound(amatc,2),lbound(amatc,3):ubound(amatc,3)))
          sl%amatc = amatc
       endif
       if ( allocated(amatn) ) then
          if ( allocated(sl%amatn) ) deallocate(sl%amatn)
          allocate(sl%amatn(lbound(amatn,1):ubound(amatn,1),lbound(amatn,2):ubound(amatn,2)))
          sl%amatn = amatn
       endif
       if ( allocated(amatp) ) then
          if ( allocated(sl%amatp) ) deallocate(sl%amatp)
          allocate(sl%amatp(lbound(amatp,1):ubound(amatp,1),lbound(amatp,2):ubound(amatp,2),lbound(amatp,3):ubound(amatp,3)))
          sl%amatp = amatp
       endif
       if ( allocated(amatt) ) then
          if ( allocated(sl%amatt) ) deallocate(sl%amatt)
          allocate(sl%amatt(lbound(amatt,1):ubound(amatt,1),lbound(amatt,2):ubound(amatt,2),lbound(amatt,3):ubound(amatt,3)))
          sl%amatt = amatt
       endif
       if ( allocated(amatu) ) then
          if ( allocated(sl%amatu) ) deallocate(sl%amatu)
          allocate(sl%amatu(lbound(amatu,1):ubound(amatu,1),lbound(amatu,2):ubound(amatu,2),lbound(amatu,3):ubound(amatu,3)))
          sl%amatu = amatu
       endif
       if ( allocated(amatw) ) then
          if ( allocated(sl%amatw) ) deallocate(sl%amatw)
          allocate(sl%amatw(lbound(amatw,1):ubound(amatw,1),lbound(amatw,2):ubound(amatw,2),lbound(amatw,3):ubound(amatw,3)))
          sl%amatw = amatw
       endif
       if ( allocated(an) ) then
          if ( allocated(sl%an) ) deallocate(sl%an)
          allocate(sl%an(lbound(an,1):ubound(an,1)))
          sl%an = an
       endif
       if ( allocated(apoks) ) then
          if ( allocated(sl%apoks) ) deallocate(sl%apoks)
          allocate(sl%apoks(lbound(apoks,1):ubound(apoks,1),lbound(apoks,2):ubound(apoks,2)))
          sl%apoks = apoks
       endif
       if ( allocated(apomu) ) then
          if ( allocated(sl%apomu) ) deallocate(sl%apomu)
          allocate(sl%apomu(lbound(apomu,1):ubound(apomu,1),lbound(apomu,2):ubound(apomu,2)))
          sl%apomu = apomu
       endif
