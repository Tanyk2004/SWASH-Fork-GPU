!
!   Purpose
!
!   In-memory checkpoints of the complete flow state ("save / branch / restore")
!   for the engine API.  This file is GENERATED by engine/gen_state.py from the
!   allocatable arrays declared in src/SwashFlowdata.ftn90 and
!   src/SwashRigBoddata.ftn90 (253 + 39 arrays); regenerate it when those
!   modules change.  Scalars (time, time step, step counters, CFL) are saved
!   alongside.  The existing hot file (SwashBackup) only stores water level and
!   velocities between COMPUTE blocks; this stores everything, at any step.
!
!   Known limitation: boundary values read from SERIES files are not rewound,
!   so restoring to an earlier time with file-driven boundaries is not exact.
!
    use SwashFlowdata
    use SwashRigBoddata
    use SwashTimecomm, only: timco, dt, chtime
    use SwashCommdata3, only: cflmax
    use SwashRun, only: it, istep
!
    implicit none
!
    integer, parameter :: max_slots = 8
!
