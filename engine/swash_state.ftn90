!
    subroutine state_restore ( islot )
       implicit none
       integer, intent(in) :: islot
       type(state_slot), pointer :: sl
       !
       sl => slots(islot)
       if ( .not.sl%used ) return
       timco  = sl%timco
       dt     = sl%dt
       cflmax = sl%cflmax
       it     = sl%it
       istep  = sl%istep
       chtime = sl%chtime
       !
       if ( allocated(sl%brks) .and. allocated(brks) ) brks = sl%brks
       if ( allocated(sl%ibb) .and. allocated(ibb) ) ibb = sl%ibb
       if ( allocated(sl%ibl) .and. allocated(ibl) ) ibl = sl%ibl
       if ( allocated(sl%ibr) .and. allocated(ibr) ) ibr = sl%ibr
       if ( allocated(sl%ibt) .and. allocated(ibt) ) ibt = sl%ibt
       if ( allocated(sl%lfbs) .and. allocated(lfbs) ) lfbs = sl%lfbs
       if ( allocated(sl%mcell) .and. allocated(mcell) ) mcell = sl%mcell
       if ( allocated(sl%mlev) .and. allocated(mlev) ) mlev = sl%mlev
       if ( allocated(sl%presp) .and. allocated(presp) ) presp = sl%presp
       if ( allocated(sl%presu) .and. allocated(presu) ) presu = sl%presu
       if ( allocated(sl%presv) .and. allocated(presv) ) presv = sl%presv
       if ( allocated(sl%uwetp) .and. allocated(uwetp) ) uwetp = sl%uwetp
       if ( allocated(sl%vwetp) .and. allocated(vwetp) ) vwetp = sl%vwetp
       if ( allocated(sl%wets) .and. allocated(wets) ) wets = sl%wets
       if ( allocated(sl%wetu) .and. allocated(wetu) ) wetu = sl%wetu
       if ( allocated(sl%wetv) .and. allocated(wetv) ) wetv = sl%wetv
       if ( allocated(sl%ishif) .and. allocated(ishif) ) ishif = sl%ishif
       if ( allocated(sl%a) .and. allocated(a) ) a = sl%a
       if ( allocated(sl%advec) .and. allocated(advec) ) advec = sl%advec
       if ( allocated(sl%advecx) .and. allocated(advecx) ) advecx = sl%advecx
       if ( allocated(sl%advecy) .and. allocated(advecy) ) advecy = sl%advecy
       if ( allocated(sl%amat) .and. allocated(amat) ) amat = sl%amat
       if ( allocated(sl%amatc) .and. allocated(amatc) ) amatc = sl%amatc
       if ( allocated(sl%amatn) .and. allocated(amatn) ) amatn = sl%amatn
       if ( allocated(sl%amatp) .and. allocated(amatp) ) amatp = sl%amatp
       if ( allocated(sl%amatt) .and. allocated(amatt) ) amatt = sl%amatt
       if ( allocated(sl%amatu) .and. allocated(amatu) ) amatu = sl%amatu
       if ( allocated(sl%amatw) .and. allocated(amatw) ) amatw = sl%amatw
       if ( allocated(sl%an) .and. allocated(an) ) an = sl%an
       if ( allocated(sl%apoks) .and. allocated(apoks) ) apoks = sl%apoks
       if ( allocated(sl%apomu) .and. allocated(apomu) ) apomu = sl%apomu
       if ( allocated(sl%apomv) .and. allocated(apomv) ) apomv = sl%apomv
       if ( allocated(sl%apors) .and. allocated(apors) ) apors = sl%apors
       if ( allocated(sl%aporu) .and. allocated(aporu) ) aporu = sl%aporu
       if ( allocated(sl%aporv) .and. allocated(aporv) ) aporv = sl%aporv
       if ( allocated(sl%b) .and. allocated(b) ) b = sl%b
       if ( allocated(sl%bcrp) .and. allocated(bcrp) ) bcrp = sl%bcrp
       if ( allocated(sl%bcrpo) .and. allocated(bcrpo) ) bcrpo = sl%bcrpo
       if ( allocated(sl%bcs) .and. allocated(bcs) ) bcs = sl%bcs
       if ( allocated(sl%bcso) .and. allocated(bcso) ) bcso = sl%bcso
