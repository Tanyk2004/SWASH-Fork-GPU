!
!  SWASH service routines for flexible mesh
!
!  Contents of this file
!
!     perot
!     pcgu
!     pcgstab
!     pcgstab3
!     distdot (from sparskit2)
!
subroutine perot ( u, ks, ke )
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWASH (Simulating WAves till SHore); a non-hydrostatic wave-flow model
!     Copyright (C) 2010-2023  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!    1.00: Marcel Zijlema
!
!   Updates
!
!    1.00, January 2017: New subroutine
!
!   Purpose
!
!   Computes the cell velocity vector in terms of face normal components using Perot's formula
!
!   Modules used
!
    use ocpcomm4
    use SwanGriddata
    use SwanGridobjects
    use SwashFlowdata, only: uvc
!
    implicit none
!
!   Argument variables
!
    integer,                       intent(in) :: ke       ! last index in vertical direction
    integer,                       intent(in) :: ks       ! first index in vertical direction
    real, dimension(nfaces,ks:ke), intent(in) :: u        ! flow velocity at faces
!
!   Local variables
!
    integer                                   :: icell    ! loop counter over cells
    integer                                   :: icelll   ! left cell of present face
    integer                                   :: icellr   ! right cell of present face
    integer, save                             :: ient = 0 ! number of entries in this subroutine
    integer                                   :: iface    ! face index
    integer                                   :: jf       ! loop counter
    integer                                   :: k        ! loop counter in vertical direction
    !
    real                                      :: area     ! area of present cell
    real                                      :: lf       ! length of face
    real                                      :: rsgn     ! sign for indicating face orientation
    real                                      :: xc       ! x-coordinate of cell circumcenter
    real                                      :: xf       ! x-coordinate of face center
    real                                      :: yc       ! y-coordinate of cell circumcenter
    real                                      :: yf       ! y-coordinate of face center
    !
    type(celltype), dimension(:), pointer     :: cell     ! datastructure for cells with their attributes
    type(facetype), dimension(:), pointer     :: face     ! datastructure for faces with their attributes
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
    if (ltrace) call strace (ient,'perot')
    !
    ! point to cell and face objects
    !
    cell => gridobject%cell_grid
    face => gridobject%face_grid
    !
    uvc = 0.
    !
    do icell = 1, ncells
       !
       ! get coordinates of the cell circumcenter
       !
       xc = cell(icell)%attr(CELLCCX)
       yc = cell(icell)%attr(CELLCCY)
       !
       do k = ks, ke
          !
          do jf = 1, cell(icell)%nof
             !
             ! face identifier
             !
             iface = cell(icell)%face(jf)%atti(FACEID)
             !
             ! get length of the face
             !
             lf = face(iface)%attr(FACELEN)
             !
             ! get coordinates of the midface
             !
             xf = face(iface)%attr(FACEMX)
             yf = face(iface)%attr(FACEMY)
             !
             ! consider left and right cells of the face
             !
             icelll = face(iface)%atti(FACECL)
             icellr = face(iface)%atti(FACECR)
             !
             ! take into account orientation of the face
             !
             if ( icell == icelll ) then
                rsgn =  1.
             else if ( icell == icellr ) then
                rsgn = -1.
             endif
             !
             ! compute the cell velocity vector using Perot's formula
             !
             uvc(icell,k,1) = uvc(icell,k,1) + rsgn * lf * ( xf - xc ) * u(iface,k)
             uvc(icell,k,2) = uvc(icell,k,2) + rsgn * lf * ( yf - yc ) * u(iface,k)
             !
          enddo
          !
       enddo
       !
       area = cell(icell)%attr(CELLAREA)
       !
       uvc(icell,:,:) = uvc(icell,:,:) / area
       !
    enddo
    !
end subroutine perot
!
subroutine pcgu ( amat, rhs, x )
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWASH (Simulating WAves till SHore); a non-hydrostatic wave-flow model
!     Copyright (C) 2010-2023  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!    1.00: Marcel Zijlema
!
!   Updates
!
!    1.00, February 2020: New subroutine
!
!   Purpose
!
!   Solves system of equations by means of preconditioned conjugate gradient algorithm
!
!   Method
!
!   System of equations assembled on triangular mesh
!
!   System of equations in single precision
!
!   The system is supposed to be symmetric and positive definite
!
!   A diagonal matrix D is computed in order to scale the system with the inverse of D
!
!   The well-known CG method is applied for the solution of preconditioned Ax = b
!
!   Modules used
!
    use ocpcomm4
    use SwashCommdata3, only: pnums
    use SwashSolvedata
    use SwanGriddata
    use SwanGridobjects
!
    implicit none
!
!   Argument variables
!
    real, dimension(ncells,0:3), intent(inout) :: amat ! coefficient matrix of the system of equations
    real, dimension(ncells    ), intent(inout) :: rhs  ! right-hand side of the system of equations
    real, dimension(ncells    ), intent(out)   :: x    ! solution of the system of equations
!
!   Parameter variables
!
    double precision, parameter :: epsmac = 1d-18 ! machine precision number
!
!   Local variables
!
    integer       :: icell    ! loop counter over cells
    integer       :: icelll   ! left cell of present face
    integer       :: icellr   ! right cell of present face
    integer, save :: ient = 0 ! number of entries in this subroutine
    integer       :: iface    ! face index
    integer       :: j        ! iteration counter
    integer       :: jf       ! loop counter
    integer       :: maxit    ! maximum number of iterations
    !
    real          :: a        ! inner product of conjugate vector and matrix times conjugate vector
    real          :: alpha    ! coefficients in expansion of the solution formed by conjugate vectors
    real          :: beta     ! coefficients in Gram-Schmidt orthogonalization
    real          :: epslin   ! required accuracy in the linear solver
    real          :: reps     ! accuracy with respect to the initial residual used in the following termination criterion:
                              !
                              !  ||b-Ax || < reps*||b-Ax ||
                              !        j                0
                              !
    real          :: rho      ! inner product of the residual vector
    real          :: rhold    ! inner product of the residual vector from previous iteration
    real          :: rnorm    ! 2-norm of residual vector
    real          :: rnrm0    ! 2-norm of initial residual vector
    real          :: ueps     ! minimal accuracy based on machine precision
    !
    type(celltype), dimension(:), pointer  :: cell     ! datastructure for cells with their attributes
    type(facetype), dimension(:), pointer  :: face     ! datastructure for faces with their attributes
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
    if (ltrace) call strace (ient,'pcgu')
    !
    ! point to cell and face objects
    !
    cell => gridobject%cell_grid
    face => gridobject%face_grid
    !
    reps  = pnums(21)
    maxit = nint(pnums(24))
    !
    ! compute diagonal elements for scaling the system
    !
    diag(:) = amat(:,0)
    !
    ! compute initial residual
    !
    do icell = 1, ncells
       !
       resd(icell) = amat(icell,0) * x(icell)
       !
       ! loop over faces of the cell
       !
       do jf = 1, cell(icell)%nof
          !
          ! face identifier
          !
          iface = cell(icell)%face(jf)%atti(FACEID)
          !
          ! consider left and right cells of current face
          !
          icelll = face(iface)%atti(FACECL)
          icellr = face(iface)%atti(FACECR)
          !
          if ( icell == icelll .and. icellr /= 0 ) then
             resd(icell) = resd(icell) + amat(icell,jf) * x(icellr)
          else if ( icell == icellr .and. icelll /= 0 ) then
             resd(icell) = resd(icell) + amat(icell,jf) * x(icelll)
          endif
          !
       enddo
       !
    enddo
    !
    resd = rhs - resd
    z    = resd / diag
    !
    s = z
    !
    rho = 0.
    do icell = 1, ncells
       !
       rho = rho + resd(icell)*z(icell)
       !
    enddo
    !
    rnrm0 = sqrt(rho)
    !
    epslin = reps*rnrm0
    ueps   = 1000.*real(epsmac)*rnrm0
    !
    if ( epslin < ueps .and. rnrm0 > 0. ) then
       !
       if ( iamout > 0 ) then
          write (PRINTF, '(a)') ' ++ pcg: the required accuracy is too small'
          write (PRINTF, '(a,e12.6)') '         required accuracy    = ',epslin
          write (PRINTF, '(a,e12.6)') '         appropriate accuracy = ',ueps
       endif
       !
       epslin = ueps
       !
    endif
    !
    do j = 1, maxit
       !
       do icell = 1, ncells
          !
          r(icell) = amat(icell,0) * s(icell)
          !
          ! loop over faces of the cell
          !
          do jf = 1, cell(icell)%nof
             !
             ! face identifier
             !
             iface = cell(icell)%face(jf)%atti(FACEID)
             !
             ! consider left and right cells of current face
             !
             icelll = face(iface)%atti(FACECL)
             icellr = face(iface)%atti(FACECR)
             !
             if ( icell == icelll .and. icellr /= 0 ) then
                r(icell) = r(icell) + amat(icell,jf) * s(icellr)
             else if ( icell == icellr .and. icelll /= 0 ) then
                r(icell) = r(icell) + amat(icell,jf) * s(icelll)
             endif
             !
          enddo
          !
       enddo
       !
       a = 0.
       do icell = 1, ncells
          !
          a = a + s(icell)*r(icell)
          !
       enddo
       !
       alpha = rho / a
       !
       x    = x    + alpha*s
       resd = resd - alpha*r
       z    = resd / diag
       !
       rhold = rho
       !
       rho = 0.
       do icell = 1, ncells
          !
          rho = rho + resd(icell)*z(icell)
          !
       enddo
       rnorm = sqrt(rho)
       !
       if ( iamout == 2 ) then
          write (PRINTF, '(a,i3,a,e12.6)') ' ++ pcg: iter = ',j,'    res = ',rnorm
       endif
       !
       if ( .not. rnorm > epslin ) exit
       !
       beta = rho / rhold
       !
       s = z + beta*s
       !
    enddo
    !
    ! investigate the reason for stopping
    !
    if ( rnorm > epslin .and. iamout > 0 ) then
       !
       write (PRINTF, '(a)') ' ++ pcg: no convergence for solving system of equations'
       write (PRINTF, '(a,i3)'   ) '         total number of iterations     = ',j
       write (PRINTF, '(a,e12.6)') '         2-norm of the residual         = ',rnorm
       write (PRINTF, '(a,e12.6)') '         required accuracy              = ',epslin
       !
    else if ( iamout == 3 ) then
       !
       write (PRINTF, '(a,e12.6)') ' ++ pcg: 2-norm of the initial residual = ',rnrm0
       write (PRINTF, '(a,i3)'   ) '         total number of iterations     = ',j
       write (PRINTF, '(a,e12.6)') '         2-norm of the residual         = ',rnorm
       !
    endif
    !
end subroutine pcgu
!
subroutine pcgstab ( amat, rhs, x )
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWASH (Simulating WAves till SHore); a non-hydrostatic wave-flow model
!     Copyright (C) 2010-2023  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!    1.00: Marcel Zijlema
!
!   Updates
!
!    1.00, February 2020: New subroutine
!
!   Purpose
!
!   Solves system of equations by means of preconditioned BiCGSTAB method
!
!   Method
!
!   wrapper to call the sparskit2 routines
!   store matrix based on the CSR format
!
!   Modules used
!
    use ocpcomm4
    use SwashCommdata3, only: pnums
    use SwashSolvedata
    use SwanGriddata
    use SwanGridobjects
!
    implicit none
!
!   Argument variables
!
    real, dimension(ncells,0:3), intent(in)  :: amat ! coefficient matrix of the system of equations
    real, dimension(ncells    ), intent(in)  :: rhs  ! right-hand side of the system of equations
    real, dimension(ncells    ), intent(out) :: x    ! solution of the system of equations
!
!   Local variables
!
    integer                :: icell    ! loop counter over cells
    integer                :: icelll   ! left cell of present face
    integer                :: icellr   ! right cell of present face
    integer, save          :: ient = 0 ! number of entries in this subroutine
    integer                :: ierr     ! error indicator
    integer                :: iface    ! face index
    integer, dimension(16) :: ipar     ! array for the reverse communication protocol
    integer, save          :: j        ! iteration counter
    integer                :: jf       ! loop counter
    integer                :: n        ! counter
    !
    real*8                 :: bnorm    ! 2-norm of right-hand side vector
    real*8                 :: dnrm2    ! computes 2-norm
    real*8                 :: epslin   ! required accuracy in the linear solver
    real*8, dimension(16)  :: fpar     ! array storing information to and from BiCGSTAB
    real*8, save           :: rnorm    ! 2-norm of residual vector
    real*8                 :: rnrm0    ! 2-norm of initial residual vector
    !
    logical                :: STPNOW   ! indicates that program must stop
    !
    type(celltype), dimension(:), pointer  :: cell     ! datastructure for cells with their attributes
    type(facetype), dimension(:), pointer  :: face     ! datastructure for faces with their attributes
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
    if (ltrace) call strace (ient,'pcgstab')
    !
    ! point to cell and face objects
    !
    cell => gridobject%cell_grid
    face => gridobject%face_grid
    !
    ! set the parameters for the iterative solver
    !
    ipar(1) = 0
    ipar(2) = 2
    ipar(3) = 2
    ipar(4) = 8*ncells
    ipar(6) = nint(pnums(25))
    fpar(1) = dble(pnums(22))
    fpar(2) = 0d0
    !
    ! restore matrix using the CSR format
    !
    n = 0
    !
    do icell = 1, ncells
       !
       n = n + 1
       !
       ia(icell) = n
       !
       ax(n) = dble(amat(icell,0))
       ja(n) = icell
       !
       ! loop over faces of the cell
       !
       do jf = 1, cell(icell)%nof
          !
          n = n + 1
          !
          ax(n) = dble(amat(icell,jf))
          !
          ! face identifier
          !
          iface = cell(icell)%face(jf)%atti(FACEID)
          !
          ! consider left and right cells of current face
          !
          icelll = face(iface)%atti(FACECL)
          icellr = face(iface)%atti(FACECR)
          !
          if ( icell == icelll .and. icellr /= 0 ) then
             ja(n) = icellr
          else if ( icell == icellr .and. icelll /= 0 ) then
             ja(n) = icelll
          endif
          !
       enddo
       !
    enddo
    !
    ia(ncells+1) = ia(1) + n
    !
    ! set up the preconditioner
    !
    call ilut ( ncells, ax, ja, ia, 3, 1d-4, au, jau, ju, 7*ncells, wk, iw, ierr )
    ipar(2) = 2
    !
    sol = dble(x)
    rs  = dble(rhs)
    !
    j      = 0
    rnorm  = 0d0
    bnorm  = dnrm2(ncells,rs,1)
    epslin = fpar(1)*bnorm
    !
 10 call bcgstab ( ncells, rs, sol, ipar, fpar, wk )
    !
    if ( ipar(7) /= j ) then
       if ( j == 1 ) rnrm0 = rnorm
       if ( iamout == 2 ) then
          write (PRINTF, '(a,i3,a,e12.6)') ' ++ bcgstab: iter = ',j,'    res = ',real(fpar(6))
       endif
       j = ipar(7)
    endif
    rnorm = fpar(5)
    !
    if ( ipar(1) == 1 ) then
       call amux ( ncells, wk(ipar(8)), wk(ipar(9)), ax, ja, ia )
       goto 10
    else if ( ipar(1) == 2 ) then
       call atmux ( ncells, wk(ipar(8)), wk(ipar(9)), ax, ja, ia )
       goto 10
    else if ( ipar(1) == 3 .or. ipar(1) == 5 ) then
       call lusol ( ncells, wk(ipar(8)), wk(ipar(9)), au, jau, ju )
       goto 10
    else if ( ipar(1) == 4 .or. ipar(1) == 6 ) then
       call lutsol ( ncells, wk(ipar(8)), wk(ipar(9)), au, jau, ju )
       goto 10
    else if ( ipar(1) <= 0 ) then
       if ( ipar(1) == 0 ) then
          ! bcgstab has satisfied convergence test
       else if ( ipar(1) == -1 ) then
          call msgerr ( 1, 'bcgstab has iterated too many times' )
       else if ( ipar(1) == -2 ) then
          call msgerr ( 1, 'bcgstab was not given enough work space' )
          write (PRINTF, '(a,i5,a)') 'work space should at least have ', ipar(4),' entries'
       else if ( ipar(1) == -3 ) then
          call msgerr ( 1, 'bcgstab is facing a break-down' )
       else
          call msgerr ( 2, 'iterative solver terminated' )
          write (PRINTF,'(a,i3)') 'return code = ',ipar(1)
       endif
    endif
    !
    x = real(sol)
    !
    ! investigate the reason for stopping
    !
    if ( iamout > 0 .and. ipar(1) < 0 ) then
       !
       write (PRINTF, '(a)') ' ++ bcgstab: no convergence for solving system of equations'
       write (PRINTF, '(a,i3)'   ) '             total number of iterations     = ',ipar(7)
       write (PRINTF, '(a,e12.6)') '             2-norm of the residual         = ',real(fpar(6))
       write (PRINTF, '(a,e12.6)') '             required accuracy              = ',real(epslin)
       !
    else if ( iamout == 3 ) then
       !
       write (PRINTF, '(a,e12.6)') ' ++ bcgstab: 2-norm of the initial residual = ',real(rnrm0)
       write (PRINTF, '(a,i3)'   ) '             total number of iterations     = ',ipar(7)
       write (PRINTF, '(a,e12.6)') '             2-norm of the residual         = ',real(fpar(6))
       !
    endif
    !
end subroutine pcgstab
!
subroutine pcgstab3 ( amat, rhs, x )
!
!   --|-----------------------------------------------------------|--
!     | Delft University of Technology                            |
!     | Faculty of Civil Engineering and Geosciences              |
!     | Environmental Fluid Mechanics Section                     |
!     | P.O. Box 5048, 2600 GA  Delft, The Netherlands            |
!     |                                                           |
!     | Programmer: Marcel Zijlema                                |
!   --|-----------------------------------------------------------|--
!
!
!     SWASH (Simulating WAves till SHore); a non-hydrostatic wave-flow model
!     Copyright (C) 2010-2023  Delft University of Technology
!
!     This program is free software: you can redistribute it and/or modify
!     it under the terms of the GNU General Public License as published by
!     the Free Software Foundation, either version 3 of the License, or
!     (at your option) any later version.
!
!     This program is distributed in the hope that it will be useful,
!     but WITHOUT ANY WARRANTY; without even the implied warranty of
!     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
!     GNU General Public License for more details.
!
!     You should have received a copy of the GNU General Public License
!     along with this program. If not, see <http://www.gnu.org/licenses/>.
!
!
!   Authors
!
!    1.00: Marcel Zijlema
!
!   Updates
!
!    1.00, April 2020: New subroutine
!
!   Purpose
!
!   Solves multiple layer system of equations by means of preconditioned BiCGSTAB method
!
!   Method
!
!   wrapper to call the sparskit2 routines
!   store matrix based on the CSR format
!
!   Modules used
!
    use ocpcomm4
    use SwashCommdata3, only: qmax, pnums
    use SwashSolvedata
    use SwashFlowdata, only: nconct, ishif
    use SwanGriddata
    use SwanGridobjects
!
    implicit none
!
!   Argument variables
!
    real, dimension(ncells,qmax,0:nconct), intent(in)  :: amat ! coefficient matrix of the system of equations
    real, dimension(ncells,qmax         ), intent(in)  :: rhs  ! right-hand side of the system of equations
    real, dimension(ncells,qmax         ), intent(out) :: x    ! solution of the system of equations
!
!   Local variables
!
    integer                :: icell    ! loop counter over cells
    integer                :: icelll   ! left cell of present face
    integer                :: icellr   ! right cell of present face
    integer, save          :: ient = 0 ! number of entries in this subroutine
    integer                :: ierr     ! error indicator
    integer                :: iface    ! face index
    integer, dimension(16) :: ipar     ! array for the reverse communication protocol
    integer, save          :: j        ! iteration counter
    integer                :: jf       ! loop counter
    integer                :: k        ! loop counter over vertical layers
    integer                :: m        ! loop counter
    integer                :: n        ! counter
    integer                :: ntot     ! matrix size
    !
    real*8                 :: bnorm    ! 2-norm of right-hand side vector
    real*8                 :: dnrm2    ! computes 2-norm
    real*8                 :: epslin   ! required accuracy in the linear solver
    real*8, dimension(16)  :: fpar     ! array storing information to and from BiCGSTAB
    real*8, save           :: rnorm    ! 2-norm of residual vector
    real*8                 :: rnrm0    ! 2-norm of initial residual vector
    !
    logical                :: STPNOW   ! indicates that program must stop
    !
    type(celltype), dimension(:), pointer  :: cell     ! datastructure for cells with their attributes
    type(facetype), dimension(:), pointer  :: face     ! datastructure for faces with their attributes
!
!   Structure
!
!   Description of the pseudo code
!
!   Source text
!
    if (ltrace) call strace (ient,'pcgstab3')
    !
    ! point to cell and face objects
    !
    cell => gridobject%cell_grid
    face => gridobject%face_grid
    !
    ntot = ncells * qmax
    !
    ! set the parameters for the iterative solver
    !
    ipar(1) = 0
    ipar(2) = 2
    ipar(3) = 2
    ipar(4) = 8*ntot
    ipar(6) = nint(pnums(25))
    fpar(1) = dble(pnums(22))
    fpar(2) = 0d0
    !
    ! restore matrix using the CSR format
    !
    n = 0
    !
    do k = 1, qmax
       !
       do icell = 1, ncells
          !
          n = n + 1
          !
          ia(icell+(k-1)*ncells) = n
          !
          ax(n) = dble(amat(icell,k,0))
          ja(n) = icell+(k-1)*ncells
          !
          if ( k > 2 ) then
             n = n + 1
             ax(n) = dble(amat(icell,k,4))
             ja(n) = icell+(k-3)*ncells
          endif
          !
          if ( k > 1 ) then
             n = n + 1
             ax(n) = dble(amat(icell,k,8))
             ja(n) = icell+(k-2)*ncells
          endif
          !
          do m = 1, nconct-17
             if ( k+m < qmax+1 ) then
                n = n + 1
                ax(n) = dble(amat(icell,k,ishif(m)))
                ja(n) = icell+(k+m-1)*ncells
             endif
          enddo
          !
          ! loop over faces of the cell
          !
          do jf = 1, cell(icell)%nof
             !
             n = n + 1
             !
             ax(n) = dble(amat(icell,k,jf))
             !
             ! face identifier
             !
             iface = cell(icell)%face(jf)%atti(FACEID)
             !
             ! consider left and right cells of current face
             !
             icelll = face(iface)%atti(FACECL)
             icellr = face(iface)%atti(FACECR)
             !
             if ( icell == icelll .and. icellr /= 0 ) then
                ja(n) = icellr+(k-1)*ncells
             else if ( icell == icellr .and. icelll /= 0 ) then
                ja(n) = icelll+(k-1)*ncells
             endif
             !
          enddo
          !
          if ( k > 2 ) then
             !
             do jf = 1, cell(icell)%nof
                !
                n = n + 1
                !
                ax(n) = dble(amat(icell,k,4+jf))
                !
                ! face identifier
                !
                iface = cell(icell)%face(jf)%atti(FACEID)
                !
                ! consider left and right cells of current face
                !
                icelll = face(iface)%atti(FACECL)
                icellr = face(iface)%atti(FACECR)
                !
                if ( icell == icelll .and. icellr /= 0 ) then
                   ja(n) = icellr+(k-3)*ncells
                else if ( icell == icellr .and. icelll /= 0 ) then
                   ja(n) = icelll+(k-3)*ncells
                endif
                !
             enddo
             !
          endif
          !
          if ( k > 1 ) then
             !
             do jf = 1, cell(icell)%nof
                !
                n = n + 1
                !
                ax(n) = dble(amat(icell,k,8+jf))
                !
                ! face identifier
                !
                iface = cell(icell)%face(jf)%atti(FACEID)
                !
                ! consider left and right cells of current face
                !
                icelll = face(iface)%atti(FACECL)
                icellr = face(iface)%atti(FACECR)
                !
                if ( icell == icelll .and. icellr /= 0 ) then
                   ja(n) = icellr+(k-2)*ncells
                else if ( icell == icellr .and. icelll /= 0 ) then
                   ja(n) = icelll+(k-2)*ncells
                endif
                !
             enddo
             !
          endif
          !
          if ( k < qmax ) then
             !
             do jf = 1, cell(icell)%nof
                !
                n = n + 1
                !
                ax(n) = dble(amat(icell,k,12+jf))
                !
                ! face identifier
                !
                iface = cell(icell)%face(jf)%atti(FACEID)
                !
                ! consider left and right cells of current face
                !
                icelll = face(iface)%atti(FACECL)
                icellr = face(iface)%atti(FACECR)
                !
                if ( icell == icelll .and. icellr /= 0 ) then
                   ja(n) = icellr+k*ncells
                else if ( icell == icellr .and. icelll /= 0 ) then
                   ja(n) = icelll+k*ncells
                endif
                !
             enddo
             !
          endif
          !
          if ( k < qmax-1 ) then
             !
             do jf = 1, cell(icell)%nof
                !
                n = n + 1
                !
                ax(n) = dble(amat(icell,k,16+jf))
                !
                ! face identifier
                !
                iface = cell(icell)%face(jf)%atti(FACEID)
                !
                ! consider left and right cells of current face
                !
                icelll = face(iface)%atti(FACECL)
                icellr = face(iface)%atti(FACECR)
                !
                if ( icell == icelll .and. icellr /= 0 ) then
                   ja(n) = icellr+(k+1)*ncells
                else if ( icell == icellr .and. icelll /= 0 ) then
                   ja(n) = icelll+(k+1)*ncells
                endif
                !
             enddo
             !
          endif
          !
       enddo
       !
    enddo
    !
    ia(ntot+1) = ia(1) + n
    !
    ! set up the preconditioner
    !
    call ilut ( ntot, ax, ja, ia, 3, 1d-4, au, jau, ju, 7*ntot, wk, iw, ierr )
    ipar(2) = 2
    !
    do k = 1, qmax
       do icell = 1, ncells
          sol(icell+(k-1)*ncells) = dble(  x(icell,k))
          rs (icell+(k-1)*ncells) = dble(rhs(icell,k))
       enddo
    enddo
    !
    j      = 0
    rnorm  = 0d0
    bnorm  = dnrm2(ntot,rs,1)
    epslin = fpar(1)*bnorm
    !
 10 call bcgstab ( ntot, rs, sol, ipar, fpar, wk )
    !
    if ( ipar(7) /= j ) then
       if ( j == 1 ) rnrm0 = rnorm
       if ( iamout == 2 ) then
          write (PRINTF, '(a,i3,a,e12.6)') ' ++ bcgstab: iter = ',j,'    res = ',real(fpar(6))
       endif
       j = ipar(7)
    endif
    rnorm = fpar(5)
    !
    if ( ipar(1) == 1 ) then
       call amux ( ntot, wk(ipar(8)), wk(ipar(9)), ax, ja, ia )
       goto 10
    else if ( ipar(1) == 2 ) then
       call atmux ( ntot, wk(ipar(8)), wk(ipar(9)), ax, ja, ia )
       goto 10
    else if ( ipar(1) == 3 .or. ipar(1) == 5 ) then
       call lusol ( ntot, wk(ipar(8)), wk(ipar(9)), au, jau, ju )
       goto 10
    else if ( ipar(1) == 4 .or. ipar(1) == 6 ) then
       call lutsol ( ntot, wk(ipar(8)), wk(ipar(9)), au, jau, ju )
       goto 10
    else if ( ipar(1) <= 0 ) then
       if ( ipar(1) == 0 ) then
          ! bcgstab has satisfied convergence test
       else if ( ipar(1) == -1 ) then
          call msgerr ( 1, 'bcgstab has iterated too many times' )
       else if ( ipar(1) == -2 ) then
          call msgerr ( 1, 'bcgstab was not given enough work space' )
          write (PRINTF, '(a,i5,a)') 'work space should at least have ', ipar(4),' entries'
       else if ( ipar(1) == -3 ) then
          call msgerr ( 1, 'bcgstab is facing a break-down' )
       else
          call msgerr ( 2, 'iterative solver terminated' )
          write (PRINTF,'(a,i3)') 'return code = ',ipar(1)
       endif
    endif
    !
    do k = 1, qmax
       do icell = 1, ncells
          x(icell,k) = real(sol(icell+(k-1)*ncells))
       enddo
    enddo
    !
    ! investigate the reason for stopping
    !
    if ( iamout > 0 .and. ipar(1) < 0 ) then
       !
       write (PRINTF, '(a)') ' ++ bcgstab: no convergence for solving system of equations'
       write (PRINTF, '(a,i3)'   ) '             total number of iterations     = ',ipar(7)
       write (PRINTF, '(a,e12.6)') '             2-norm of the residual         = ',real(fpar(6))
       write (PRINTF, '(a,e12.6)') '             required accuracy              = ',real(epslin)
       !
    else if ( iamout == 3 ) then
       !
       write (PRINTF, '(a,e12.6)') ' ++ bcgstab: 2-norm of the initial residual = ',real(rnrm0)
       write (PRINTF, '(a,i3)'   ) '             total number of iterations     = ',ipar(7)
       write (PRINTF, '(a,e12.6)') '             2-norm of the residual         = ',real(fpar(6))
       !
    endif
    !
end subroutine pcgstab3
!
function distdot ( n, x, ix, y, iy )
  integer n, ix, iy
  real*8 distdot, x(*), y(*), ddot
  distdot = ddot(n,x,ix,y,iy)
  return
end
